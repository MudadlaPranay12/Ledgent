# Ledgent Environment Variables
# Never commit actual secrets to git.

# Voice mode: dev, gnani, or mock
VOICE=mock

# Gateway WebSocket URL (wss:// when using HTTPS)
# Override with ?gw= URL param or localStorage if needed
# Default: wss://localhost:8080
GATEWAY_URL=""

# Gnani API key (read from environment, never committed)
# Set this on your deployed gateway host, not in the repo
GNANI_API_KEY=""

# Allowed origin for WebSocket upgrades
# Must match the page's origin for production use
ALLOWED_ORIGIN=""

# Optional: gateway session token rate limiting config
# (handled by the gateway server)