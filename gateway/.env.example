# Copy to gateway/.env and fill in. gateway/.env is gitignored.
GNANI_API_KEY=
# Comma-separated browser origins allowed to open the voice socket.
ALLOWED_ORIGIN=http://localhost:8080
GATEWAY_PORT=8787
# Timbre v3.0 voice (Shivani, Avinash, Lakshmi, ... see docs.gnani.ai voice catalog)
GNANI_TTS_VOICE=Shivani
